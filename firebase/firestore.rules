rules_version = '2';

// Regras do Firestore da telemetria do Uniq System.
// O app só pode CRIAR lotes de eventos em /telemetry, com formato validado.
// Ninguém lê, altera ou apaga pelo app: a leitura é feita só pelo comando
// `npm run logs`, com a chave de administrador (que ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {
    match /telemetry/{batchId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['installId', 'appVersion', 'env', 'hostname', 'platform', 'sentAt', 'events'])
        && request.resource.data.installId is string
        && request.resource.data.installId.size() > 0
        && request.resource.data.installId.size() <= 64
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 32
        && request.resource.data.env is string
        && request.resource.data.env.size() <= 16
        && request.resource.data.hostname is string
        && request.resource.data.hostname.size() <= 64
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 128
        && request.resource.data.sentAt is timestamp
        && request.resource.data.events is list
        && request.resource.data.events.size() > 0
        && request.resource.data.events.size() <= 300;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
